generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id            String   @id @default(cuid())
  name          String
  title         String
  email         String
  phone         String?
  linkedin      String?
  whatsapp      String?
  bio           String?  @db.Text
  contactIntro  String?  @db.Text
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AboutSection {
  id        String   @id @default(cuid())
  label     String
  heading   String
  content   String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Certification {
  id           String   @id @default(cuid())
  name         String
  issuer       String?
  issueDate    String?
  credentialId String?
  url          String?
  imageUrl     String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  imageUrl    String?
  videoUrl    String?
  tags        String[]
  link        String?
  category    String?  
  order       Int      @default(0)
  media       ProjectMedia[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectMedia {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  iconName    String?
  slug        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
